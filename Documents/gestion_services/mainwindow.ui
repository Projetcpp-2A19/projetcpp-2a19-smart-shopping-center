     <property name="styleSheet">
      <string notr="true">QPushButton {
    font: 16pt &quot;Segoe UI&quot;;
    color: rgb(255, 255, 255);
    border: 2px solid white;
    border-radius: 6px;
    background-color: #00a2c6;
    min-width: 80px;
}

QPushButton:hover {
    font: 18pt &quot;Segoe UI&quot;; /* Agrandir le texte au survol */
}

QPushButton:pressed {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                      stop: 0 #dadbde, stop: 1 #f6f7fa);
}

QPushButton:flat {
    border: none; /* pas de bordure pour un bouton plat */
}

QPushButton:default {
    border-color: navy; /* rendre le bouton par défaut plus visible */
}
</string>
     </property>
     <property name="text">
      <string>Dashboard</string>
     </property>
    </widget>
