     <property name="styleSheet">
      <string notr="true">QPushButton {
	font: 14pt &quot;Segoe UI&quot;;
	color: rgb(255, 255, 255);
    border: 2px solid white;
    border-radius: 6px;
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
