   <widget class="QTableWidget" name="tableWidget">
    <property name="geometry">
     <rect>
      <x>530</x>
      <y>220</y>
      <width>521</width>
      <height>321</height>
     </rect>
    </property>
    <property name="styleSheet">
     <string notr="true">QTableWidget {
    background-color: #f5f5f5;  /* Fond gris clair pour le tableau */
    border-radius: 10px;         /* Coins arrondis pour un effet moderne */
    font-family: 'Segoe UI', sans-serif;
    font-size: 14px;
    color: #333;  /* Couleur de texte sombre */
    border: 1px solid #ddd;  /* Bordure gris clair */
    padding: 10px;
}

QTableWidget::item {
    padding: 12px;
    border-bottom: 1px solid #e0e0e0;  /* Séparateurs fins entre les lignes */
    transition: background-color 0.3s ease;  /* Transition douce au survol */
}

QTableWidget::item:selected {
    background-color: #007bff;  /* Bleu vif lorsque l'élément est sélectionné */
    color: white;                /* Texte en blanc lorsqu'un élément est sélectionné */
    border: 1px solid #0056b3;   /* Bordure bleu foncé quand sélectionné */
}

QTableWidget::item:hover {
    background-color: #B3D4FF;  /* Bleu clair lorsqu'on survole la cellule */
    cursor: pointer;            /* Curseur main pour indiquer l'interaction */
}

QTableWidget::horizontalHeader {
    background-color: #0056b3;  /* Bleu foncé pour l'en-tête */
    color: white;
    border: none;
    padding: 12px;
    font-size: 16px;
    text-align: center;
    border-radius: 8px 8px 0 0;  /* Coins arrondis en haut */
}

QTableWidget::horizontalHeader::section {
    padding: 10px;
    border-right: 2px solid #4a90e2;  /* Lignes de séparation claires entre les colonnes */
}

QTableWidget::horizontalHeader::item {
    font-weight: bold;
}

QTableWidget::verticalHeader {
    background-color: #0056b3;  /* Même bleu foncé pour l'en-tête vertical */
    color: white;
    padding: 10px;
    font-size: 14px;
    font-weight: bold;
}

QTableWidget::verticalHeader::section {
    border-right: 2px solid #4a90e2;  /* Séparateur vertical léger */
    padding: 10px;
}

QTableWidget::item:focus {
    border: 1px solid #007bff;  /* Bordure bleue claire lorsque l'élément est en focus */
}

QTableWidget::item:checked {
    background-color: #007bff;  /* Bleu clair quand l'élément est sélectionné */
    color: white;
}

QTableWidget QTableCornerButton::section {
    background-color: #0056b3;
    border: none;
}
</string>
    </property>
